# 本地构建产物。CI 会为每个 tag 交叉编译并挂到 Release，仓库里不放二进制。
bin/

# Node 工具层的依赖只装在 test/ 下（mqtt / mqtt-packet）。
test/node_modules/

# 互操作跑的是 Python，py_compile 与 import 都会留下字节码缓存。
/test/__pycache__/

# 手工排障时的临时目录。
/.tmp/

# -store 指向的本地状态目录与追加日志，跑过就有，不该进版本库。
# state.log 是内部/store/file.go 里写死的文件名，跟着 -store 走到哪写到哪，所以不锚定。
state.log
# 这条必须锚定在根：写成 store/ 会连 internal/store/ 一起吃掉，
# 第一次 CI 就是这么挂的——本地 go build 全绿，仓库里却没有那个包。
/store/
